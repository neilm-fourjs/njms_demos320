{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    // Programs compile into njm_app_bin<GENVER> (see BIN in the Makefile), so run them from there.
    // GENVER must be set to the major release (e.g. 600) in the environment VS Code starts from.
    "version": "0.2.0",
    "configurations": [
        {
            "type": "fgldb-dap",
            "request": "launch",
            "name": "(4gl) Launch current file",
            "program": "${workspaceFolder}/njm_app_bin${env:GENVER}/${fileBasenameNoExtension}",
            "args": [],
            "stopAtEntry": true,
            "externalConsole": false,
            "cwd": "${workspaceFolder}/njm_app_bin${env:GENVER}",
            "env": {
                "FGLIMAGEPATH": "${workspaceFolder}/pics:${workspaceFolder}/pics/fa6.txt",
                "FGLRESOURCEPATH": "${workspaceFolder}/etc",
                "FGLDBPATH": "${workspaceFolder}/etc",
                "FGLPROFILE": "${workspaceFolder}/etc/pgs/profile",
                "FGLLDPATH": "${workspaceFolder}/njm_app_bin${env:GENVER}:${env:GREDIR}/lib",
                "DBNAME": "njm_demo400",
                "DBTYPE": "pgs",
                "DB_LOCALE": "en_GB.utf8",
                "LANG": "en_GB.utf8"
            }
        },
        {
            "type": "fgldb-dap",
            "request": "launch",
            "name": "(4gl) Launch menu",
            "program": "${workspaceFolder}/njm_app_bin${env:GENVER}/menu",
            "args": [],
            "stopAtEntry": true,
            "externalConsole": false,
            "cwd": "${workspaceFolder}/njm_app_bin${env:GENVER}",
            "env": {
                "FGLIMAGEPATH": "${workspaceFolder}/pics:${workspaceFolder}/pics/fa6.txt",
                "FGLRESOURCEPATH": "${workspaceFolder}/etc",
                "FGLDBPATH": "${workspaceFolder}/etc",
                "FGLPROFILE": "${workspaceFolder}/etc/pgs/profile",
                "FGLLDPATH": "${workspaceFolder}/njm_app_bin${env:GENVER}:${env:GREDIR}/lib",
                "DBNAME": "njm_demo400",
                "DBTYPE": "pgs",
                "DB_LOCALE": "en_GB.utf8",
                "LANG": "en_GB.utf8"
            }
        }
    ]
}
